              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) pm.collectionVariables.set('faqId', json.data.faq.id);",
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"What is the dress code on campus?\",\n  \"answer\": \"Students are expected to wear modest, college-appropriate clothing. Lab coats are required inside science and computer laboratories.\",\n  \"category\": \"{{categoryId}}\"\n}" },
            "url": "{{baseUrl}}/api/faqs"
          }
        },
