{
  "info": {
    "_postman_id": "c1a2e5b7-4d8f-4b3a-9c2d-campusai0001",
    "name": "Campus AI — College FAQ Assistant",
    "description": "Complete API test suite for Campus AI.\n\nHOW TO USE\n1. Start the server (npm start) and run the seed (npm run seed).\n2. Run \"Auth → Login (admin)\" — it stores the admin token automatically.\n3. Run \"Auth → Login (creator)\" — stores the creator token.\n4. Run \"Auth → Login (student)\" — stores the student token.\n5. Folder \"Admin (token: admin)\" = admin token; \"Creator (token: creator)\" = creator token; \"Protected (token: student)\" = student token; public requests need no token.\n\nROLE MODEL: public (no token) / user / creator / admin. FAQ writes need creator or admin; PATCH/DELETE are ownership-checked (creator: own FAQ only; admin: any).\n\nVariables are set on the collection: baseUrl, adminToken, creatorToken, studentToken, faqId, categoryId, unansweredId, creatorFaqId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminToken", "value": "" },
    { "key": "creatorToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "faqId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "unansweredId", "value": "" },
    { "key": "creatorFaqId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register (valid)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
