            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Student Again\",\n  \"email\": \"test.student@campus.ai\",\n  \"password\": \"Test@12345\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "POST /api/auth/login (admin) → stores adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) pm.collectionVariables.set('adminToken', json.data.token);",
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@campus.ai\",\n  \"password\": \"Admin@12345\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
